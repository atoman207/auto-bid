# =============================================================
#  履歴書AI自動生成アプリ — 環境変数
#  ローカル: このファイルを .env.local にコピーして値を入れてください
#  Vercel : Project Settings → Environment Variables に同じ名前で登録
# =============================================================

# ----- OpenAI -------------------------------------------------
# 必須。https://platform.openai.com/api-keys
OPENAI_API_KEY=
# 文章生成モデル（既定: gpt-4o-mini）
OPENAI_MODEL=gpt-4o-mini
# 音声合成モデルと声（既定: gpt-4o-mini-tts / coral）
# 声: alloy, ash, ballad, coral, echo, fable, onyx, nova, sage, shimmer, verse, marin, cedar
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# ----- Google スプレッドシート（サービスアカウント） --------------
# 必須。README の「Google の設定」を参照。
# 方法A: メールと秘密鍵を個別に設定（秘密鍵は \n を含む1行のまま貼り付けてOK）
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# 方法B: サービスアカウントの JSON をそのまま（または Base64 化して）貼り付け
# GOOGLE_SERVICE_ACCOUNT_JSON=
# 必須。スプレッドシートURL https://docs.google.com/spreadsheets/d/【ここ】/edit
GOOGLE_SPREADSHEET_ID=

# ----- 管理画面 ------------------------------------------------
# 必須。/admin のログインパスワード
ADMIN_PASSWORD=
# 必須。ログインCookieと学習ページURLの署名に使う長いランダム文字列（32文字以上）
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ※ 運用開始後に変更すると、配布済みの学習ページURLが無効になります
APP_SECRET=

# ----- Vercel Blob（模範音声MP3の保存先） ------------------------
# 推奨。Vercel の Storage → Blob を作成してプロジェクトに接続すると自動で設定されます
BLOB_READ_WRITE_TOKEN=
# Blob ストアの種類: public（既定）または private
BLOB_ACCESS=public

# ----- その他 --------------------------------------------------
# 本番URL（例: https://rirekisho.example.com）。未設定ならアクセス中のURLを使用
APP_BASE_URL=
# true にすると同じ連絡先から何度でも送信できます（テスト用。本番は false）
ALLOW_DUPLICATE_SUBMISSIONS=false
